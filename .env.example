# Telegram Admin User IDs (comma-separated, e.g. 12345678,87654321)
ADMIN_IDS=your_telegram_id_here

# Telegram Bot Token from @BotFather
BOT_TOKEN=your_telegram_bot_token_here

# Treblo API Key from https://treblo.com/developers
TREBLO_API_KEY=your_treblo_api_key_here

# YooKassa payment settings (https://yookassa.ru)
YOOKASSA_SHOP_ID=your_shop_id_here
YOOKASSA_SECRET_KEY=your_secret_key_here
WEBHOOK_PORT=8080
WEBHOOK_PATH=/webhook/yookassa

# SQLite Database path
DATABASE_PATH=bot_database.db

# Initial free generations/credits for new users
INITIAL_USER_CREDITS=3

# Generation cost in bot credits
GENERATION_COST=1

# Optional: Mandatory Telegram Channel for subscription check
# (Can also be configured and toggled dynamically in /admin)
# REQUIRED_CHANNEL=@your_channel_or_id
# REQUIRED_CHANNEL_URL=https://t.me/your_channel
